{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "benson/laravel-firebird",
  "description": "Firebird database driver for the Laravel Framework",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "illuminate/support": "^12.17|^13.0",
    "illuminate/container": "^12.17|^13.0",
    "illuminate/database": "^12.17|^13.0",
    "illuminate/events": "^12.17|^13.0"
  },
  "require-dev": {
    "mockery/mockery": "^1.6",
    "phpunit/phpunit": "^11.5|^12.0",
    "orchestra/testbench": "^10.3|^11.0",
    "fakerphp/faker": "^1.24"
  },
  "archive": {
    "exclude": [
      "/tests"
    ]
  },
  "autoload": {
    "psr-4": {
      "Benson\\LaravelFirebird\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Benson\\LaravelFirebird\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Benson\\LaravelFirebird\\FirebirdServiceProvider"
      ]
    }
  }
}
